
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas
PORT=4000

# ── Authentication ───────────────────────────────────────────────────────────
# Single admin key (simple deployments)
ATLAS_API_KEY=atl_changeme_generate_with_generateApiKey_fn

# Multi-key RBAC (optional, takes precedence over ATLAS_API_KEY if set).
# Format: comma-separated key:role pairs. Valid roles: admin, operator, viewer
# Example: ATLAS_API_KEY_ROLES=atl_abc123:admin,atl_def456:operator,atl_ghi789:viewer
ATLAS_API_KEY_ROLES=

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Do NOT use * in production.
ATLAS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_ID=worker-1
POLL_INTERVAL_MS=500
LEASE_DURATION_MS=30000
LOG_LEVEL=info

# ── External integrations (optional) ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=
