{
  "name": "atlas-workflow-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed saga orchestrator — API, worker, and engine packages",
  "scripts": {
    "dev:api": "ts-node-dev --respawn --transpile-only apps/api/src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only apps/worker/src/worker.ts",
    "start:api": "ts-node apps/api/src/server.ts",
    "start:worker": "ts-node apps/worker/src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "nanoid": "^3.3.7",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.11.6",
    "@types/ws": "^8.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
